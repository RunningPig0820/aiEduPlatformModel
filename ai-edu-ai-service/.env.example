# LLM API Keys (必须配置，不要提交此文件!)
# ============================================

# 智谱 AI (GLM 系列模型)
# 获取地址: https://open.bigmodel.cn/
ZHIPU_API_KEY=填入你的智谱API_KEY

# DeepSeek
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=填入你的DeepSeek_API_KEY

# 阿里云百炼 (通义千问)
# 获取地址: https://bailian.console.aliyun.com/
# 注意: 需要 DashScope API Key
DASHSCOPE_API_KEY=填入你的DashScope_API_KEY
# 兼容旧配置名
BAILIAN_API_KEY=填入你的百炼_API_KEY


# 豆包(火山方舟) - 看图答疑
# ============================================
# 获取地址: https://console.volcengine.com/ark
DOUBAO_API_KEY=填入你的方舟ARK_API_KEY


# OCR API Keys (课标PDF识别)
# ============================================

# 百度 OCR API (收费服务，按次计费)
# 获取地址: https://console.bce.baidu.com/ai/#/ai/ocr/overview/index
BAIDU_OCR_API_KEY=填入你的百度OCR_API_KEY
BAIDU_OCR_SECRET_KEY=填入你的百度OCR_SECRET_KEY


# 服务配置
# ============================================

# Java 后端调用 AI 服务的内部 Token
# 建议: 生成一个随机字符串
INTERNAL_TOKEN=your_internal_token_here

# 服务端口
PORT=9527

# 调试模式
DEBUG=false


# 可选配置
# ============================================

# 默认使用的 LLM Provider
DEFAULT_PROVIDER=zhipu

# 默认模型
DEFAULT_MODEL=glm-4-flash

# 日志级别
LOG_LEVEL=INFO


# AI 答疑 (Tutoring) 配置
# ============================================
# 看图答疑需视觉能力 → 豆包 doubao-seed-2-0-lite

# decide 决策模型 (判断密集)
TUTORING_DECIDE_PROVIDER=doubao
TUTORING_DECIDE_MODEL=doubao-seed-2-0-lite-260428

# generate 生成模型 (内容生成)
TUTORING_GENERATE_PROVIDER=doubao
TUTORING_GENERATE_MODEL=doubao-seed-2-0-lite-260428

# 温度: decide 偏低 (判断要稳), generate 偏高 (内容要有层次)
TUTORING_DECIDE_TEMPERATURE=0.3
TUTORING_GENERATE_TEMPERATURE=0.7


# Neo4j 知识图谱配置
# ============================================

# Neo4j 连接 URI (bolt 协议用于数据操作)
NEO4J_URI=bolt://81.71.130.57:7687
# Neo4j HTTP 端口 (用于浏览器访问)
NEO4J_HTTP_URI=http://81.71.130.57:7474
# Neo4j 用户名
NEO4J_USER=neo4j
# Neo4j 密码
NEO4J_PASSWORD=Neo4j_2025@Edu

# Redis 配置 (可选，用于缓存)
# REDIS_URL=redis://your-redis-server:6379


# COS 向量桶 (题型聚集向量服务)
# ============================================
# 腾讯云 COS 向量桶——Java 无 SDK, 向量操作走 Python 桥。
# embedding 复用上面 DASHSCOPE_API_KEY (text-embedding-v3, 768 维), 不新增密钥。

# 子账号 API 密钥 (需向量桶操作权限)
COS_VECTORS_SECRET_ID=填入你的COS子账号SecretId
COS_VECTORS_SECRET_KEY=填入你的COS子账号SecretKey

# 桶所在区域 (如 ap-guangzhou) + 向量桶名 (格式 xxx-125xxxxxxx)
COS_VECTORS_REGION=ap-guangzhou
COS_VECTORS_BUCKET=填入你的向量桶名

# 逻辑类型 → 物理索引 路由表 (vector_type 必填, 本期唯一合法值 "topic";
# question/rag 为预留索引, 后续按需启用)
COS_VECTORS_INDEXES={"topic": "topic-index", "rag": "rag-index", "rag-full": "rag-full", "rag-slice": "rag-slice"}   # 双池: rag-full 全量池/rag-slice 切片池


# 百度 OCR API (收费服务)
# 获取地址: https://console.bce.baidu.com/ai/#/ai/ocr/overview/index
BAIDU_OCR_API_KEY=填入你的百度OCR_API_KEY
BAIDU_OCR_SECRET_KEY=填入你的百度OCR_SECRET_KEY